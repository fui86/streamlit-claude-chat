{
  "manifest_version": 2,
  "name": "Karaoke Video Player",
  "version": "1.0.0",
  "description": "Scarica video da YouTube e riproducili a schermo intero sul secondo monitor con gestione karaoke",
  "permissions": [
    "downloads",
    "storage",
    "tabs",
    "https://www.youtube.com/*",
    "https://youtube.com/*"
  ],
  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "scripts": ["background-firefox.js"],
    "persistent": false
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": "script-src 'self'; object-src 'self'",
  "browser_specific_settings": {
    "gecko": {
      "id": "karaoke-player@fui86.github.io",
      "strict_min_version": "91.0"
    }
  }
}
